# Environment Variables for AI Avatar Studio
# Copy this file to .env and customize as needed

# ===== DATABASE CONFIGURATION =====
DATABASE_PATH=/app/data/database/projects.db
# Note: Path inside container. Mapped to docker_volumes/data/database/projects.db on host

# ===== PATH CONFIGURATION =====
MODELS_PATH=/app/models
OUTPUT_PATH=/app/output
CACHE_PATH=/app/data/cache
LOGS_PATH=/app/data/logs

# ===== APPLICATION SETTINGS =====
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Show console output in GUI
SHOW_CONSOLE=true

# Auto-save projects
AUTO_SAVE=true

# Maximum cache size in MB (0 = unlimited)
MAX_CACHE_SIZE_MB=2048

# ===== PROCESSING SETTINGS =====
# Use GPU if available (true/false)
USE_GPU=false

# Number of worker threads for batch processing
WORKER_THREADS=2

# Default video resolution (480p, 720p, 1080p)
DEFAULT_RESOLUTION=1080p

# Default video format (mp4, avi, webm)
DEFAULT_VIDEO_FORMAT=mp4

# Default video quality (low, medium, high)
DEFAULT_VIDEO_QUALITY=high

# ===== TTS SETTINGS =====
# Default TTS engine (coqui, pyttsx3, gtts)
DEFAULT_TTS_ENGINE=coqui

# Default voice
DEFAULT_TTS_VOICE=jenny

# Default speech speed (0.5 - 2.0)
DEFAULT_TTS_SPEED=1.0

# Default speech pitch (0.5 - 2.0)
DEFAULT_TTS_PITCH=1.0

# ===== AUDIO SETTINGS =====
# Enable audio enhancement by default
ENABLE_AUDIO_ENHANCEMENT=true

# Enable noise reduction
ENABLE_NOISE_REDUCTION=true

# Audio normalization target (dB)
AUDIO_NORMALIZATION_TARGET=-20

# ===== VIDEO SETTINGS =====
# Enable background removal by default
ENABLE_BACKGROUND_REMOVAL=false

# Enable subtitles by default
ENABLE_SUBTITLES=false

# Video FPS
VIDEO_FPS=25

# ===== FACE DETECTION SETTINGS =====
# Face detection confidence threshold (0.0 - 1.0)
FACE_DETECTION_CONFIDENCE=0.7

# Face detection method (mediapipe, opencv, mtcnn)
FACE_DETECTION_METHOD=mediapipe

# ===== MODEL SETTINGS =====
# Auto-download models on first run
AUTO_DOWNLOAD_MODELS=true

# Model download URL (if using custom mirror)
# MODEL_DOWNLOAD_URL=https://custom-mirror.com/models/

# ===== PERFORMANCE SETTINGS =====
# Maximum parallel processing jobs
MAX_PARALLEL_JOBS=1

# Memory limit per job (MB)
MEMORY_LIMIT_MB=4096

# Processing timeout (seconds, 0 = no timeout)
PROCESSING_TIMEOUT=3600

# ===== CLEANUP SETTINGS =====
# Auto-cleanup cache after N days
CACHE_CLEANUP_DAYS=7

# Auto-cleanup logs after N days
LOG_CLEANUP_DAYS=30

# Auto-cleanup failed generations after N days
FAILED_CLEANUP_DAYS=7

# ===== SECURITY SETTINGS =====
# Maximum file upload size (MB)
MAX_UPLOAD_SIZE_MB=10

# Allowed image formats (comma-separated)
ALLOWED_IMAGE_FORMATS=jpg,jpeg,png,bmp

# Allowed audio formats (comma-separated)
ALLOWED_AUDIO_FORMATS=wav,mp3,ogg,flac

# Maximum text input length (characters)
MAX_TEXT_LENGTH=5000

# ===== DOCKER-SPECIFIC SETTINGS =====
# Timezone
TZ=UTC

# Python optimization
PYTHONUNBUFFERED=1
PYTHONOPTIMIZE=1

# ===== DEVELOPMENT SETTINGS =====
# Debug mode (enables detailed logging)
DEBUG=false

# Enable profiling
ENABLE_PROFILING=false

# Enable testing mode
TESTING_MODE=false

# ===== WEB INTERFACE (Optional) =====
# Enable web interface (future feature)
ENABLE_WEB_INTERFACE=false

# Web server port
WEB_PORT=8080

# Web server host
WEB_HOST=0.0.0.0

# ===== BACKUP SETTINGS =====
# Auto-backup interval (hours, 0 = disabled)
AUTO_BACKUP_INTERVAL=0

# Maximum number of backups to keep
MAX_BACKUPS=10

# Backup directory
BACKUP_DIR=/app/backups

# ===== NOTIFICATION SETTINGS =====
# Enable desktop notifications
ENABLE_NOTIFICATIONS=true

# Play sound on completion
PLAY_SOUND_ON_COMPLETE=true

# ===== ADVANCED SETTINGS =====
# FFmpeg additional arguments (for advanced users)
# FFMPEG_EXTRA_ARGS=-preset ultrafast

# Wav2Lip model quality (96, 288, or custom path)
WAV2LIP_MODEL_SIZE=96

# Face padding percentage (0-100)
FACE_PADDING=10

# ===== GPU SETTINGS (if USE_GPU=true) =====
# CUDA device ID (0 for first GPU)
CUDA_DEVICE_ID=0

# NVIDIA specific
# NVIDIA_VISIBLE_DEVICES=all
# NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ===== PROXY SETTINGS (if behind firewall) =====
# HTTP proxy
# HTTP_PROXY=http://proxy.company.com:8080
# HTTPS_PROXY=http://proxy.company.com:8080
# NO_PROXY=localhost,127.0.0.1
